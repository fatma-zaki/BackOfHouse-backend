// Module: verification (nest-module-map.md). Phase 3b: an individual's request with its
// documents; decisions (approve, more info, reject) arrive with Phase 4. Documents live in
// the private bucket and are reached only through short-lived signed URLs, each audited.

enum VerificationRequestStatus {
  DRAFT
  IN_REVIEW
  MORE_INFO
  APPROVED
  REJECTED

  @@map("verification_request_status")
  @@schema("app")
}

/// What a reviewer did (verification_decisions history).
enum VerificationAction {
  APPROVE
  REJECT
  REQUEST_INFO
  REMOVE

  @@map("verification_action")
  @@schema("app")
}

enum VerificationDocumentType {
  IDENTITY
  EXPERIENCE

  @@map("verification_document_type")
  @@schema("app")
}

/// An individual's verification request (contracts/app `VerificationRequest`). One per
/// member for now; it never grants verification by itself (Phase 4 decides).
model VerificationRequest {
  id               String                    @id @default(uuid(7)) @db.Uuid
  userId           String                    @map("user_id") @db.Uuid
  status           VerificationRequestStatus @default(DRAFT)
  submittedAt      DateTime?                 @map("submitted_at") @db.Timestamptz(6)
  /// 3 working days (Sun–Thu, Riyadh) after the last submission.
  dueAt            DateTime?                 @map("due_at") @db.Timestamptz(6)
  decidedAt        DateTime?                 @map("decided_at") @db.Timestamptz(6)
  decidedByStaffId String?                   @map("decided_by_staff_id") @db.Uuid
  /// The reviewer's note or message to the member with the last decision.
  decisionNote     String?                   @map("decision_note")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_verification_requests__user_id")
  documents        VerificationDocument[]
  decisions        VerificationDecision[]
  decidedBy        StaffAccount?             @relation(fields: [decidedByStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_verification_requests__decided_by_staff_id")

  @@unique([userId], map: "uq_verification_requests__user_id")
  @@index([status, dueAt], map: "ix_verification_requests__status_due_at")
  @@map("verification_requests")
  @@schema("app")
}

/// One uploaded document per type and request; a new upload of the same type replaces it.
/// Stored only after the virus scan passed. The file name is the member's, for display.
model VerificationDocument {
  id          String                   @id @default(uuid(7)) @db.Uuid
  requestId   String                   @map("request_id") @db.Uuid
  document    VerificationDocumentType
  fileName    String                   @map("file_name")
  contentType String                   @map("content_type")
  sizeBytes   Int                      @map("size_bytes")
  sha256      String
  bucket      String
  path        String
  uploadedAt  DateTime                 @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  request     VerificationRequest      @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_verification_documents__request_id")

  @@unique([requestId, document], map: "uq_verification_documents__request_document")
  @@map("verification_documents")
  @@schema("app")
}

/// Every reviewer decision on a request, newest last (history for appeals and audit).
model VerificationDecision {
  id        String              @id @default(uuid(7)) @db.Uuid
  requestId String              @map("request_id") @db.Uuid
  action    VerificationAction
  note      String?
  staffId   String              @map("staff_id") @db.Uuid
  decidedAt DateTime            @default(now()) @map("decided_at") @db.Timestamptz(6)
  request   VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_verification_decisions__request_id")
  staff     StaffAccount        @relation(fields: [staffId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_verification_decisions__staff_id")

  @@index([requestId, decidedAt], map: "ix_verification_decisions__request_decided_at")
  @@map("verification_decisions")
  @@schema("app")
}
