// Module: companies. Phase 2 creates the company at registration (contracts/app
// /auth/register, ADR-030: one Company Account per company). Phase 3a adds the profile.

enum CompanyType {
  EVENT_ORGANIZER
  SUPPLIER
  VENUE
  PRODUCTION
  AGENCY
  SERVICE_PROVIDER
  OTHER

  @@map("company_type")
  @@schema("app")
}

/// How a company entered the platform (contracts/admin `CompanyAdmin.source`).
enum CompanySource {
  SIGNUP
  IMPORT

  @@map("company_source")
  @@schema("app")
}

enum CompanyStatus {
  DRAFT

  @@map("company_status")
  @@schema("app")
}

/// A company and its single Company Account (account_user_id, ADR-030). The type is a
/// classification, never a permission. Verification is a fact set by review (Phase 3b).
model Company {
  id                String        @id @default(uuid(7)) @db.Uuid
  accountUserId     String        @map("account_user_id") @db.Uuid
  name              String
  /// Stable public handle: the name in Latin letters plus the id prefix (unique by construction).
  slug              String        @default("")
  /// app.normalize_ar(name), written by the app; directory search (A–Z index).
  nameNormalized    String        @default("") @map("name_normalized")
  companyType       CompanyType   @map("company_type")
  status            CompanyStatus @default(DRAFT)
  specialization    String        @default("")
  city              String        @default("")
  description       String        @default("")
  services          String[]      @default([])
  industries        String[]      @default([])
  /// The company's public business contact (not the account's sign-in email or phone).
  contactEmail      String?       @map("contact_email")
  contactPhone      String?       @map("contact_phone")
  website           String?
  /// Editorial "Companies to Watch" (free, never paid). Set by staff (Phase 7).
  editorsPick       Boolean       @default(false) @map("editors_pick")
  followersCount    Int           @default(0) @map("followers_count")
  verifiedAt        DateTime?     @map("verified_at") @db.Timestamptz(6)
  verifiedByStaffId String?       @map("verified_by_staff_id") @db.Uuid
  /// Position in "Companies to Watch"; set with editors_pick by a Super admin (featured.policy.ts).
  featuredOrder     Int?          @map("featured_order")
  source            CompanySource @default(SIGNUP)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  accountUser       User          @relation(fields: [accountUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_companies__account_user_id")

  follows      CompanyFollow[]
  projects     CompanyProject[]
  profileViews CompanyProfileView[]

  claims     PageClaim[]
  verifiedBy StaffAccount? @relation("CompanyVerifiedBy", fields: [verifiedByStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_companies__verified_by_staff_id")

  @@unique([accountUserId], map: "uq_companies__account_user_id")
  @@unique([slug], map: "uq_companies__slug")
  @@index([nameNormalized(ops: raw("gin_trgm_ops"))], type: Gin, map: "ix_companies__name_normalized_trgm")
  @@index([companyType], map: "ix_companies__company_type")
  @@map("companies")
  @@schema("app")
}

/// An individual following a company. companies.followers_count moves with these rows in
/// the same transaction.
model CompanyFollow {
  userId    String   @map("user_id") @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_company_follows__user_id")
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_company_follows__company_id")

  @@id([userId, companyId], map: "company_follows_pkey")
  @@index([companyId], map: "ix_company_follows__company_id")
  @@map("company_follows")
  @@schema("app")
}

/// Portfolio work of a company (contracts/app `CompanyProject`). Not an opportunity (BQ-62).
model CompanyProject {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  title       String
  description String
  location    String
  category    String
  startedAt   DateTime  @map("started_at") @db.Date
  endedAt     DateTime? @map("ended_at") @db.Date
  services    String[]  @default([])
  clientName  String?   @map("client_name")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_company_projects__company_id")

  @@index([companyId, startedAt(sort: Desc)], map: "ix_company_projects__company_started_at")
  @@map("company_projects")
  @@schema("app")
}

/// One row per viewer per company per Riyadh day that opened the public profile
/// (contracts/app `CompanyStats.profile_views`, last 30 days).
model CompanyProfileView {
  companyId    String   @map("company_id") @db.Uuid
  viewerUserId String   @map("viewer_user_id") @db.Uuid
  day          DateTime @db.Date
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_company_profile_views__company_id")

  @@id([companyId, day, viewerUserId], map: "company_profile_views_pkey")
  @@map("company_profile_views")
  @@schema("app")
}

enum ClaimStatus {
  OPEN
  APPROVED
  REJECTED

  @@map("claim_status")
  @@schema("app")
}

enum ClaimEvidence {
  DOMAIN_MATCH
  NEEDS_DOCUMENTS
  DOCUMENTS_PROVIDED

  @@map("claim_evidence")
  @@schema("app")
}

/// A request to take over a company page (contracts/admin /claims*). Approval moves the
/// page to the claimant's account; it never verifies the company (BQ-88: no app route yet).
model PageClaim {
  id               String        @id @default(uuid(7)) @db.Uuid
  companyId        String        @map("company_id") @db.Uuid
  claimantUserId   String        @map("claimant_user_id") @db.Uuid
  /// The work email the claimant gave; its domain is compared with the company website.
  email            String
  evidence         ClaimEvidence
  status           ClaimStatus   @default(OPEN)
  decisionMessage  String?       @map("decision_message")
  decidedByStaffId String?       @map("decided_by_staff_id") @db.Uuid
  decidedAt        DateTime?     @map("decided_at") @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  company          Company       @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_page_claims__company_id")
  claimant         User          @relation(fields: [claimantUserId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_page_claims__claimant_user_id")
  decidedBy        StaffAccount? @relation(fields: [decidedByStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_page_claims__decided_by_staff_id")

  @@index([status, createdAt], map: "ix_page_claims__status_created_at")
  @@index([companyId], map: "ix_page_claims__company_id")
  @@map("page_claims")
  @@schema("app")
}
