# Widget Preview related
.widget_preview/

# ── Back Of House ────────────────────────────────────────────────────────────
# Local-only overrides (e.g. pointing at a LAN backend). config/*.json is
# committed because it holds no secrets — never put API keys in it.
config/local.json
.env
.env.*

# Android release signing
android/key.properties
*.jks
*.keystore
config/*.json