# ---------------------------------------------------------------------------
# Back Of House backend — environment template (supabase-architecture.md §11)
# Copy to .env for local work. Never commit .env. Deployed environments read
# these from the hosting platform's secrets manager.
# The process validates every value at boot and refuses to start otherwise.
# ---------------------------------------------------------------------------

NODE_ENV=development
# local | test | staging | production
APP_ENV=local
PORT=3000
# API_PUBLIC_URL=https://api.example.com
# Comma-separated browser origins. Required when APP_ENV=production.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Database (supabase-architecture.md §2) --------------------------------
# Runtime URL for api and worker. Use the SESSION pooler (port 5432) or a
# direct connection. The transaction pooler (port 6543, pgbouncer=true) works
# for the api but NOT for the worker: pg-boss needs session features.
# In deployed environments this uses the least-privilege role boh_app.
DATABASE_URL=postgresql://boh_app.<project-ref>:<password>@<pooler-host>:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Migrations only (prisma migrate deploy): owner role, direct or session pooler.
# DIRECT_URL is accepted as an alias for this variable.
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# --- Rate limiting (in-memory; single instance until TQ-16) -----------------
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=60

# --- Worker (ADR-010, ADR-011, ADR-022) --------------------------------------
# true on the worker process, false on the api.
JOBS_ENABLED=false
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# --- App surface: forced updates (GET /api/app/v1/meta/app-version, D11) ---
# Below the minimum the app blocks and opens the update URL. Update URLs are
# required in staging and production.
APP_IOS_MIN_SUPPORTED_VERSION=1.0.0
APP_IOS_LATEST_VERSION=1.0.0
# APP_IOS_UPDATE_URL=https://apps.apple.com/app/id<app-id>
APP_ANDROID_MIN_SUPPORTED_VERSION=1.0.0
APP_ANDROID_LATEST_VERSION=1.0.0
# APP_ANDROID_UPDATE_URL=https://play.google.com/store/apps/details?id=<package>

# --- Supabase Auth and Storage (needed from Stage 4 / Stage 5) --------------
# Must be the SAME Supabase project as the database above.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Server-side only. Never ship to the Flutter app, a browser bundle or a VITE_ variable.
# SUPABASE_SECRET_KEY=
STORAGE_BUCKET_PUBLIC=public-media
STORAGE_BUCKET_PRIVATE=private-documents
STORAGE_BUCKET_QUARANTINE=quarantine
SIGNED_URL_TTL_SECONDS=300
