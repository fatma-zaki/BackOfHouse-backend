{
  "name": "back-of-house-backend",
  "version": "1.0.0",
  "description": "Back Of House backend: NestJS modular monolith (api + worker) on Supabase Postgres via Prisma",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "prisma:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test,prisma}/**/*.ts\"",
    "format": "prettier --write \"{src,test,prisma}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test,prisma}/**/*.ts\"",
    "depcruise": "depcruise src --config .dependency-cruiser.js",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:integration": "jest --config ./test/jest-integration.json",
    "test:all": "npm run typecheck && npm run lint && npm run format:check && npm run depcruise && npm test && npm run test:architecture && npm run contracts && npm run test:integration",
    "contract:generate": "ts-node --transpile-only scripts/contracts/generate.ts",
    "contract:check": "node scripts/contracts/check.mjs",
    "contract:coverage": "node scripts/contracts/coverage.mjs",
    "contract:types": "openapi-typescript contracts/admin/openapi.yaml -o contracts/admin/types/admin-api.d.ts",
    "contracts": "npm run contract:coverage && npm run contract:generate && npm run contract:check",
    "gap-report": "node scripts/gap-report.mjs",
    "test:architecture": "jest --config ./test/jest-architecture.json",
    "migrations:lint": "node scripts/lint-migrations.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/supabase-js": "^2.39.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "helmet": "^7.1.0",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.0",
    "pg-boss": "10.4.2",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "4.0.9",
    "@types/node": "^20.11.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "dependency-cruiser": "18.3.1",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "9.1.2",
    "jest": "^29.7.0",
    "js-yaml": "4.3.2",
    "openapi-typescript": "7.13.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.8",
    "prisma": "7.10.1",
    "squawk-cli": "2.68.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.0"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "@nestjs/core": false
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "multer": "2.5.0",
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    }
  }
}
